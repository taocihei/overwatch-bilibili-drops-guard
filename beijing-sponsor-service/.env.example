# YunGouOS credentials. Keep the real values only in /etc/sponsor-service.env.
YUNGOUOS_MERCHANT_ID=replace_me
YUNGOUOS_PAYMENT_KEY=replace_me

# A public HTTPS URL registered as the YunGouOS async callback.
SPONSOR_CALLBACK_URL=https://api.example.com/api/sponsor/callback

SPONSOR_LISTEN_HOST=127.0.0.1
SPONSOR_LISTEN_PORT=8765
SPONSOR_DB_PATH=/var/lib/beijing-sponsor-service/orders.sqlite3
SPONSOR_LOG_LEVEL=INFO

# Number of ready, unassigned orders retained for every preset amount.
SPONSOR_POOL_TARGET=3
SPONSOR_POOL_INTERVAL_SECONDS=15
SPONSOR_ORDER_LIFETIME_SECONDS=6600
SPONSOR_EXPIRY_GUARD_SECONDS=60

# Optional. When set, create-order responses include an HMAC status_token.
# Existing desktop clients may still query by the random 128-bit order id.
SPONSOR_STATUS_TOKEN_SECRET=replace_with_a_long_random_secret
